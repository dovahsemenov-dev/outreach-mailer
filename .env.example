# Скопируй этот файл в .env и заполни значения (или задай переменные окружения).
# Формат: КЛЮЧ=ЗНАЧЕНИЕ. Файл .env добавлен в .gitignore и в git не попадёт.

# Пароль приложения Mail.ru (mail.ru -> Настройки -> Пароль и безопасность -> Пароли приложений)
MAILRU_APP_PASSWORD=

# Ключ официального API DeepSeek (https://platform.deepseek.com -> API Keys).
# Нужен ТОЛЬКО если файла llm_providers.json нет — сейчас ключи уже встроены туда.
DEEPSEEK_API_KEY=

# Имя файла с ключами провайдеров (лежит рядом с main.py, в .gitignore)
LLM_PROVIDERS_JSON=llm_providers.json
